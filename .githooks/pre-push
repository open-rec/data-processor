#!/usr/bin/env bash
set -euo pipefail
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deleting a remote ref sends an all-zero local object ID.
    [[ "$local_oid" =~ ^0+$ ]] && continue
    bash "$root/scripts/check-java-snapshot.sh" "$local_oid"
done
